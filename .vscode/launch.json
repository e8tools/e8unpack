{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug v8unpack (Remote)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["-CO", "/root/work/cpp/projects/e8unpack/build/output_dir_mod", "/root/work/cpp/projects/e8unpack/build/1Cv8_mod_outt.cf"],
            "cwd": "${command:cmake.launchTargetDirectory}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build"
        }
    ]
}